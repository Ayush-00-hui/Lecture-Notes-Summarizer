# NoteNest Environment Configuration
# Google Gemini API key (optional: if omitted, NoteNest runs in offline extractive mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Default model configuration: gemini-1.5-flash or gemini-1.5-pro
DEFAULT_MODEL=gemini-1.5-flash
DEFAULT_TEMPERATURE=0.2

# Database URL
DATABASE_URL=sqlite+aiosqlite:///./notenest.db

# Server port and host
PORT=8000
HOST=0.0.0.0
